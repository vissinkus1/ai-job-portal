# ============================================================
# AI Job Portal — Environment Variables Template
# Copy this file to `server/.env` (and `Client/.env` if deploying separately)
# ============================================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=production

# --- Database ---
# MongoDB connection string (e.g. MongoDB Atlas cluster or local mongodb://localhost:27017/ai_job_portal)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_job_portal?retryWrites=true&w=majority

# --- Security & JWT ---
# Strong random secret key for signing JWT tokens (min 32 chars recommended)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_random
ACCESS_TOKEN_EXPIRY=15m

# --- Frontend Origin (CORS & Socket.io) ---
# Comma-separated list of allowed origins or single URL (e.g. your Vercel/Netlify domain)
FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# --- Email Service (Nodemailer for OTP & Welcome Emails) ---
# Gmail App Password (NOT your regular account password) or any SMTP provider
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Client Configuration (Set in Client/.env or your Vercel/Netlify Environment Variables) ---
# VITE_API_URL=https://your-backend-api.onrender.com
